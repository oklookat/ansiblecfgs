{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "tag": "dns-in",
    "queryStrategy": "UseIP",
    "servers": [
      {
        "address": "https://1.1.1.1/dns-query"
      },
      {
        "address": "https://8.8.8.8/dns-query"
      }
    ]
  },
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "outboundTag": "block-out",
        "protocol": [
          "bittorrent",
          "quic"
        ]
      }
    ]
  },
  "inbounds": [
    {
      "tag": "vless-in",
      "protocol": "vless",
      "listen": "::",
      "port": "{{ xray_listen_port }}",
      "settings": {
        "clients": [
          {
            "id": "{{ xray_uuid }}",
            "email": "love@xray.com",
            "flow": ""
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "host": "",
          "path": "{{ xray_xhttp_path }}",
          "mode": "auto"
        }
      },
      "sniffing": {
        "enabled": true,
        "routeOnly": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct-out",
      "protocol": "freedom",
      "settings": {
        "targetStrategy": "UseIP"
      }
    },
    {
      "tag": "block-out",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "http"
        }
      }
    }
  ],
  "geodata": {
    "cron": "0 4 * * 1",
    "outbound": "direct-out",
    "assets": [
      {
        "url": "{{ xray_geoip_url }}",
        "file": "geoip.dat"
      },
      {
        "url": "{{ xray_geosite_url }}",
        "file": "geosite.dat"
      }
    ]
  }
}
