#!/bin/bash
set -e
set -o pipefail

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

log "Starting Xray geo update..."

{% for file in xray_geofiles %}
log "Downloading {{ file.dest }} from {{ file.url }}..."
if curl -fSL -o "{{ file.dest }}" "{{ file.url }}"; then
    log "Successfully downloaded {{ file.dest }}"
else
    log "ERROR: Failed to download {{ file.dest }}"
    exit 1
fi
{% endfor %}

log "Restarting xray service..."
if sudo systemctl restart xray; then
    log "Xray restarted successfully"
else
    log "ERROR: Failed to restart Xray"
    exit 1
fi

log "Xray geo update completed successfully."
