[Interface]
PrivateKey = {{ peer_private_key }}
Address = {{ peer.address }}{% if wireguard_enable_ipv6 and peer.address_ipv6 | default('') | length > 0 %}, {{ peer.address_ipv6 }}{% endif %}

{% if wireguard_dns | length > 0 %}
DNS = {{ wireguard_dns }}
{% endif %}
{% if wireguard_mtu | length > 0 %}
MTU = {{ wireguard_mtu }}
{% endif %}

[Peer]
PublicKey = {{ wireguard_public_key }}
AllowedIPs = {{ peer.allowed_ips | default('0.0.0.0/0, ::/0' if wireguard_enable_ipv6 else '0.0.0.0/0') }}
Endpoint = {{ wireguard_endpoint }}:{{ wireguard_port }}
{% if peer.persistent_keepalive | default(25) | int > 0 %}
PersistentKeepalive = {{ peer.persistent_keepalive | default(25) }}
{% endif %}
{% if peer.preshared_key | default('') | length > 0 %}
PresharedKey = {{ peer.preshared_key }}
{% endif %}
