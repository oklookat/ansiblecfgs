---
services:
  {{ wireguard_container_name }}:
    image: "{{ wireguard_image }}"
    container_name: {{ wireguard_container_name }}
    restart: unless-stopped

    ports:
      - "{{ wireguard_port }}:{{ wireguard_port }}/udp"

    volumes:
      - "{{ wireguard_config }}:/config"
      - /lib/modules:/lib/modules:ro

    environment:
      PUID: "{{ wireguard_puid }}"
      PGID: "{{ wireguard_pgid }}"
      TZ: "{{ wireguard_timezone }}"
      SERVERURL: "{{ wireguard_serverurl }}"
      SERVERPORT: "{{ wireguard_serverport }}"
      PEERS: "{{ wireguard_peers }}"
      PEERDNS: "{{ wireguard_peerdns }}"
      INTERNAL_SUBNET: "{{ wireguard_internal_subnet }}"
      ALLOWEDIPS: "{{ wireguard_allowedips }}"
      PERSISTENTKEEPALIVE_PEERS: "{{ wireguard_persistentkeepalive_peers }}"
      LOG_CONFS: "{{ wireguard_log_confs }}"
{% for key, value in wireguard_extra_env.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}

    cap_add:
{% for cap in wireguard_cap_add %}
      - {{ cap }}
{% endfor %}

    sysctls:
{% for s in wireguard_sysctls %}
      - {{ s }}
{% endfor %}

    networks:
      - "{{ wireguard_network }}"

networks:
  {{ wireguard_network }}:
    name: {{ wireguard_network }}
    driver: bridge
    enable_ipv6: true
