---
services:
  {{ wireguard_container_name }}:
    build:
      context: "{{ wireguard_dir }}"
    image: "{{ wireguard_image }}"
    container_name: {{ wireguard_container_name }}
    restart: unless-stopped

    ports:
      - "{{ wireguard_port }}:{{ wireguard_port }}/udp"

    volumes:
      - "{{ wireguard_config_dir }}:/etc/wireguard:ro"
      - /lib/modules:/lib/modules:ro

    environment:
      WIREGUARD_INTERFACE: "{{ wireguard_interface }}"

    cap_add:
{% for cap in wireguard_cap_add %}
      - {{ cap }}
{% endfor %}

    sysctls:
{% for s in wireguard_sysctls %}
      - {{ s }}
{% endfor %}

    networks:
      - "{{ wireguard_network }}"

networks:
  {{ wireguard_network }}:
    name: {{ wireguard_network }}
    driver: bridge
    enable_ipv6: true
