services:
  caddy:
    build:
      context: "{{ caddy_dir }}"
    image: caddy-naive:latest
    container_name: caddy
    restart: unless-stopped
    network_mode: host

    volumes:
      - "{{ caddy_caddyfile }}:/etc/caddy/Caddyfile:ro"
      - "{{ caddy_sites_dir }}:/etc/caddy/sites:ro"
      - "{{ caddy_data }}:/data"
      - "{{ caddy_file_server }}:/var/www"
      - "{{ caddy_certificates }}:/etc/caddy/certs:ro"
