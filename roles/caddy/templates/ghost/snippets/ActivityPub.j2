# ActivityPub
# Proxy activitypub requests /.ghost/activitypub/
handle /.ghost/activitypub/* {
	reverse_proxy {{ caddy_ghost_activitypub_target }}
}

handle /.well-known/webfinger {
	reverse_proxy {{ caddy_ghost_activitypub_target }}
}

handle /.well-known/nodeinfo {
	reverse_proxy {{ caddy_ghost_activitypub_target }}
}
