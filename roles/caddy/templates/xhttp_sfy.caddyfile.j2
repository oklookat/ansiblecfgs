{{ caddy_domain }}:{{ caddy_port }} {

	{% if caddy_fullchain_path is defined and caddy_fullchain_path | length > 0 and caddy_private_key_path is defined and caddy_private_key_path | length > 0 %}
		# Manual certificates
		tls {{ caddy_fullchain_path }} {{ caddy_private_key_path }}
		{% elif caddy_acme_email is defined and caddy_acme_email | length > 0 %}
		# Auto SSL via ACME (Let's Encrypt / ZeroSSL)
		tls {
			issuer acme {
				email {{ caddy_acme_email }}
				disable_http_challenge
			}
		}
	{% endif %}

    # HSTS
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    handle /robots.txt {
        header Content-Type "text/plain"
        respond "User-agent: *\nDisallow: /\n" 200
    }

	# gRPC Proxy for VLESS / XHTTP
	reverse_proxy {{ caddy_location }} {{ caddy_grpc_pass }} {
		transport grpc
	}

	# Fallback to static web root
	root * {{ caddy_domain_dir }}
	file_server
}
