# Use the below flags to enable the Analytics or ActivityPub containers as well
# COMPOSE_PROFILES=analytics,activitypub

# Ghost domain
# Custom public domain Ghost will run on
DOMAIN={{ ghost_domain }}

# Ghost Admin domain
# If you have Ghost Admin setup on a separate domain uncomment the line below and add the domain
# You also need to uncomment the corresponding block in your Caddyfile
ADMIN_DOMAIN={{ ghost_admin_domain }}

# Database settings
# All database settings must not be changed once the database is initialised
DATABASE_ROOT_PASSWORD={{ ghost_database_root_password }}
DATABASE_USER={{ ghost_database_user }}
DATABASE_PASSWORD={{ ghost_database_password }}

# ActivityPub
ACTIVITYPUB_TARGET={{ ghost_activitypub_target }}

# Tinybird configuration
# If you want to run Analytics, paste the output from `docker compose run --rm tinybird-login get-tokens` below
{% if ghost_tinybird_api_url is defined and ghost_tinybird_api_url
   and ghost_tinybird_tracker_token is defined and ghost_tinybird_tracker_token
   and ghost_tinybird_admin_token is defined and ghost_tinybird_admin_token
   and ghost_tinybird_workspace_id is defined and ghost_tinybird_workspace_id %}
TINYBIRD_API_URL={{ ghost_tinybird_api_url }}
TINYBIRD_TRACKER_TOKEN={{ ghost_tinybird_tracker_token }}
TINYBIRD_ADMIN_TOKEN={{ ghost_tinybird_admin_token }}
TINYBIRD_WORKSPACE_ID={{ ghost_tinybird_workspace_id }}
{% endif %}

# Ghost configuration (https://ghost.org/docs/config/)

# SMTP Email (https://ghost.org/docs/config/#mail)
# Transactional email is required for logins, account creation (staff invites), password resets and other features
# This is not related to bulk mail / newsletter sending
mail__transport={{ ghost_mail_transport }}
mail__options__host={{ ghost_mail_options_host }}
mail__options__port={{ ghost_mail_options_port }}
mail__options__secure={{ ghost_mail_options_secure }}
mail__options__auth__user={{ ghost_mail_options_auth_user }}
mail__options__auth__pass={{ ghost_mail_options_auth_pass }}
mail__from="{{ ghost_mail_from }}"

# Advanced customizations

# Force Ghost version
# You should only do this if you need to pin a specific version
# The update commands won't work
GHOST_VERSION={{ ghost_version }}

# Port Ghost should listen on
# You should only need to edit this if you want to host
# multiple sites on the same server
GHOST_PORT={{ ghost_port }}

# Data locations
# Location to store uploaded data
UPLOAD_LOCATION={{ ghost_upload_location }}

# Location for database data
MYSQL_DATA_LOCATION={{ ghost_mysql_data_location }}
