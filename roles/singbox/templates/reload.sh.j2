#!/bin/sh
set -eu

CONTAINER="{{ singbox_container_name }}"
COMPOSE_FILE="{{ singbox_compose }}"

is_running() {
    docker inspect -f '{% raw %}{{.State.Running}}{% endraw %}' "$CONTAINER" 2>/dev/null | grep -q true
}

if docker container inspect "$CONTAINER" >/dev/null 2>&1 && is_running; then
    echo "Container is running, restarting..."
    docker compose -f "$COMPOSE_FILE" restart
else
    echo "Container is not running or does not exist, rebuilding and starting stack..."
    docker compose -f "$COMPOSE_FILE" up -d --build
fi

if ! is_running; then
    echo "ERROR: failed to start" >&2
    docker logs "$CONTAINER" >&2 || true
    exit 1
fi

echo "Done successfully"
exit 0
